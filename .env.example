# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_long_random_secret
AUTH_SECRET=replace_with_a_long_random_secret

# Database
# Local dev: point at a dedicated dev DB (local Postgres or Neon *branch*). Never use production Neon for `migrate dev`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zendo

# Optional: same URL as DATABASE_URL but documented separately in secrets managers (e.g. "dev branch" vs "prod").
# Prisma CLI only reads DATABASE_URL — copy your dev URL here into DATABASE_URL when running migrations locally.
# DATABASE_URL_DEV=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Optional: empty Postgres used only by `prisma migrate dev` shadow replay (see prisma.config.ts + docs/database-migrations.md).
# SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zendo_shadow

# Redis — rate limit chung, cache affiliate, khóa cron phân tán, audit ops, BullMQ (khi bật)
REDIS_URL=

# BullMQ cho queue affiliate-analytics (mặc định bật nếu có REDIS_URL; đặt 0 để tắt)
# AFFILIATE_BULLMQ=1

# Worker BullMQ: `npm run affiliate:worker`
# AFFILIATE_WORKER_CONCURRENCY=2

# Ingest tracking async (Bull queues affiliate-tracking-*). Mặc định bật khi AFFILIATE_BULLMQ + REDIS_URL; đặt 0 để luôn persist đồng bộ trong API.
# AFFILIATE_TRACKING_ASYNC=0

# Worker riêng cho ingest / attribution / realtime: `npm run affiliate:tracking-worker`
# AFFILIATE_TRACKING_WORKER_CONCURRENCY=2

# Server-side TikTok / Meta CAPI (queue affiliate-conversion-dispatch). Tắt: AFFILIATE_CAPI_DISPATCH=0
# AFFILIATE_CAPI_DISPATCH=0
# AFFILIATE_CAPI_WORKER_CONCURRENCY=2
# META_CAPI_GRAPH_VERSION=v21.0

# Fraud Phase 2.5 — Redis counters + async eval job (AFFILIATE_FRAUD_REDIS=0 tắt counters)
# AFFILIATE_FRAUD_REDIS=0
# AFFILIATE_FRAUD_AUTO_ACTIONS=0 — chỉ ghi DB, không auto hold dispatch
# AFFILIATE_FRAUD_BLOCK_CAPI_ON_CRITICAL=1 — chặn enqueue CAPI khi tier CRITICAL

# Pixel integration `config` JSON (AffiliatePixelIntegration) — ví dụ:
# TikTok: { "tiktokAccessToken": "...", "testEventCode": "..." }
# Meta: { "metaAccessToken": "...", "testEventCode": "..." }

# Ops rolling counters (minute buckets trong Redis). Tắt để snapshot dùng lại Prisma aggregate.
# AFFILIATE_OPS_REDIS_ROLLING=0

# Server-side alert cooldown (Redis SET NX theo alert id). Tắt: AFFILIATE_OPS_ALERT_SUPPRESS=0

# Cron heartbeat rolling / aggregation lag: `npm run affiliate:ops-roll-tick`
# AFFILIATE_EXPORT_MAX_PER_HOUR=24

# Số lần retry tối đa cho job affiliate (in-memory + Bull)
# AFFILIATE_JOB_MAX_ATTEMPTS=4

# Cloudflare R2 (S3 API)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=zendo-media

# Public media domain (custom domain mapped to R2 bucket)
R2_PUBLIC_BASE_URL=https://media.zendo.vn
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://media.zendo.vn

# Internal cron (cleanup jobs) — Bearer token for GET/POST /api/internal/cleanup/*
INTERNAL_CRON_SECRET=

# Affiliate CCCD draft cleanup (prefix private/affiliate-payout-change-drafts/)
AFFILIATE_PAYOUT_DRAFT_ORPHAN_TTL_HOURS=72
AFFILIATE_PAYOUT_REJECTED_MEDIA_RETENTION_DAYS=14
AFFILIATE_PAYOUT_DRAFT_CLEANUP_LIST_PAGE_SIZE=500
# AFFILIATE_PAYOUT_DRAFT_CLEANUP_DRY_RUN=true

# Optional social auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pusher (realtime chat /chat — optional; thiếu thì chat vẫn lưu DB, không push tức thì)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Optional: admin id dùng làm người gửi tin auto-reply (thiếu thì dùng admin ACTIVE đầu tiên trong DB)
SUPPORT_AUTO_REPLY_ADMIN_ID=

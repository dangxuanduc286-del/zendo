/// Server-side CAPI dispatch job (TikTok / Meta) — async, deduped, replayable.
model ConversionDispatchJob {
  id                   String                       @id @default(cuid())
  affiliateProfileId String
  orderId              String                       @db.VarChar(64)
  conversionMatchId  String?
  provider             ConversionDispatchProvider
  internalEvent        String                       @db.VarChar(40)
  payloadFingerprint   String                       @db.VarChar(64)
  dedupeKey            String                       @unique @db.VarChar(180)
  status               ConversionDispatchJobStatus  @default(QUEUED)
  attempts             Int                          @default(0)
  lastError            String?                      @db.VarChar(500)
  httpStatus           Int?
  latencyMs            Int?
  payloadSummary       Json?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  processedAt          DateTime?
  affiliateProfile     AffiliateProfile             @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)
  order                Order                        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  conversionMatch      AffiliateConversionMatch?    @relation(fields: [conversionMatchId], references: [id], onDelete: SetNull)
  providerEvents       ConversionProviderEvent[]

  @@index([affiliateProfileId, status, createdAt])
  @@index([provider, status, createdAt])
}

model ConversionProviderEvent {
  id                String                    @id @default(cuid())

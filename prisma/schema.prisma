generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  permissions Json?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  admins      Admin[]

  @@index([slug])
}

model Admin {
  id                                  String                                @id @default(cuid())
  email                               String                                @unique
  username                            String?                               @unique
  fullName                            String
  passwordHash                        String
  avatarUrl                           String?
  status                              AdminStatus                           @default(ACTIVE)
  roleId                              String
  lastLoginAt                         DateTime?
  createdAt                           DateTime                              @default(now())
  updatedAt                           DateTime                              @updatedAt
  role                                Role                                  @relation(fields: [roleId], references: [id])
  verifiedAffiliatePayoutAccounts     AffiliatePayoutAccount[]
  reviewedPayoutAccountChangeRequests AffiliatePayoutAccountChangeRequest[] @relation("PayoutChangeRequestReviewer")
  affiliateProfiles                   AffiliateProfile[]
  auditLogs                           AuditLog[]
  pages                               Page[]
  passwordResetTokens                 PasswordResetToken[]
  posts                               Post[]
  assignedSupportTickets              SupportTicket[]                       @relation("SupportTicketAssignee")
  softDeletedSupportTickets           SupportTicket[]                       @relation("SupportTicketSoftDeletedBy")
  blockedSupportTickets               SupportTicket[]                       @relation("SupportTicketBlockedBy")
  supportTicketMessages               SupportTicketMessage[]                @relation("AdminSupportTicketMessage")
  supportTicketMessagesSoftDeleted    SupportTicketMessage[]                @relation("SupportTicketMessageSoftDeletedBy")
  supportDmMessages                   SupportDmMessage[]                    @relation("SupportDmMessageSenderAdmin")
  supportDmMessagesSoftDeleted        SupportDmMessage[]                    @relation("SupportDmMessageSoftDeletedBy")
  blockedSupportDmConversations       SupportDmConversation[]             @relation("SupportDmConversationBlockedBy")
  hiddenSupportDmConversations        SupportDmConversation[]             @relation("SupportDmConversationHiddenBy")
  resolvedAffiliateFraudCases         AffiliateFraudCase[]                  @relation("AffiliateFraudCaseResolver")
  affiliateFraudActionsTaken          AffiliateFraudAction[]
  reviewedAffiliateApplications       AffiliateApplication[]                @relation("AffiliateApplicationReviewer")

  @@index([roleId])
  @@index([status])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      Admin     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model Category {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String?
  imageUrl       String?
  parentId       String?
  seoTitle       String?
  seoDescription String?
  status         ContentStatus @default(PUBLISHED)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  showOnHome     Boolean       @default(true)
  parent         Category?     @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[]    @relation("CategoryTree")
  products       Product[]

  @@unique([parentId, name])
  @@index([parentId])
  @@index([status])
  @@index([showOnHome])
  @@index([slug])
}

model Brand {
  id             String        @id @default(cuid())
  name           String        @unique
  slug           String        @unique
  description    String?
  logoUrl        String?
  website        String?
  seoTitle       String?
  seoDescription String?
  status         ContentStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  products       Product[]

  @@index([status])
  @@index([slug])
}

model Product {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  sku                    String                  @unique
  shortDescription       String?
  description            String?
  specifications         Json?
  basePrice              Decimal                 @db.Decimal(12, 2)
  salePrice              Decimal?                @db.Decimal(12, 2)
  stockQuantity          Int                     @default(0)
  isFeatured             Boolean                 @default(false)
  isNew                  Boolean                 @default(false)
  isBestSeller           Boolean                 @default(false)
  seoTitle               String?
  seoDescription         String?
  status                 ProductStatus           @default(DRAFT)
  categoryId             String
  brandId                String?
  vendorId               String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  soldCount              Int                     @default(0)
  cartItems              CartItem[]
  faqs                   FAQ[]
  orderItems             OrderItem[]
  affiliateTrafficEvents AffiliateTrafficEvent[]
  brand                  Brand?                  @relation(fields: [brandId], references: [id])
  category               Category                @relation(fields: [categoryId], references: [id])
  images                 ProductImage[]
  variants               ProductVariant[]
  reviews                Review[]

  @@index([name])
  @@index([slug])
  @@index([categoryId])
  @@index([brandId])
  @@index([vendorId])
  @@index([status])
  @@index([isFeatured, isNew, isBestSeller])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isPrimary])
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  name          String
  sku           String      @unique
  options       Json?
  price         Decimal?    @db.Decimal(12, 2)
  stockQuantity Int         @default(0)
  isDefault     Boolean     @default(false)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  cartItems     CartItem[]
  orderItems    OrderItem[]
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
  @@index([isActive])
}

model Customer {
  id                     String                        @id @default(cuid())
  email                  String?                       @unique
  phone                  String?
  fullName               String?
  passwordHash           String?
  isGuest                Boolean                       @default(false)
  guestSessionId         String?                       @unique
  marketingConsent       Boolean                       @default(false)
  notes                  String?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  addresses              Address[]
  affiliateApplications  AffiliateApplication[]
  affiliateProfiles      AffiliateProfile[]
  auditLogs              AuditLog[]
  carts                  Cart[]
  accountNotifications   CustomerAccountNotification[]
  affiliateTrafficEvents AffiliateTrafficEvent[]
  passwordResetTokens    CustomerPasswordResetToken[]
  orders                 Order[]
  reviews                Review[]
  supportTickets         SupportTicket?
  supportTicketMessages  SupportTicketMessage[]        @relation("CustomerSupportTicketMessage")
  supportDmConversation  SupportDmConversation?
  supportDmMessages      SupportDmMessage[]
  loyaltyPoints          Int                   @default(0)
  memberRank             String                @default("BRONZE") @db.VarChar(32)
  lifetimeSpent          Decimal               @default(0) @db.Decimal(12, 2)
  completedOrders        Int                   @default(0)
  loyaltyTransactions    LoyaltyTransaction[]

  @@index([phone])
  @@index([isGuest])
  @@index([guestSessionId])
}

model CustomerPasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model CustomerAccountNotification {
  id         String                              @id @default(cuid())
  customerId String
  category   CustomerAccountNotificationCategory
  dedupeKey  String                              @db.VarChar(180)
  title      String                              @db.VarChar(240)
  body       String
  actionHref String?                             @db.VarChar(512)
  readAt     DateTime?
  createdAt  DateTime                            @default(now())
  /// * Dữ liệu máy đọc (orderId, commission, trạng thái…) — hiển thị chính dùng title/body.
  metadata   Json?
  customer   Customer                            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, dedupeKey])
  @@index([customerId, category])
  @@index([customerId, createdAt])
  @@index([customerId, readAt])
}

model Address {
  id           String      @id @default(cuid())
  customerId   String
  fullName     String
  phone        String
  country      String      @default("VN")
  city         String
  district     String
  ward         String?
  line1        String
  line2        String?
  postalCode   String?
  addressType  AddressType @default(HOME)
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  districtCode String?
  fullAddress  String?
  provinceCode String?
  wardCode     String?
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([customerId])
  @@index([customerId, isDefault])
}

model Cart {
  id                 String     @id @default(cuid())
  customerId         String?
  sessionId          String?    @unique
  status             CartStatus @default(ACTIVE)
  convertedToOrderId String?
  expiresAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  customer           Customer?  @relation(fields: [customerId], references: [id])
  items              CartItem[]

  @@index([customerId])
  @@index([sessionId])
  @@index([status])
}

model CartItem {
  id               String          @id @default(cuid())
  cartId           String
  productId        String
  productVariantId String?
  quantity         Int
  unitPrice        Decimal         @db.Decimal(12, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productId, productVariantId])
  @@index([cartId])
  @@index([productId])
  @@index([productVariantId])
}

model Order {
  id                     String                  @id @default(cuid())
  code                   String                  @unique
  customerId             String?
  shippingAddressId      String?
  couponId               String?
  vendorId               String?
  customerFullName       String
  customerEmail          String?
  customerPhone          String
  shippingCountry        String                  @default("VN")
  shippingCity           String
  shippingDistrict       String
  shippingWard           String?
  shippingLine1          String
  shippingLine2          String?
  shippingPostalCode     String?
  note                   String?
  subtotal               Decimal                 @db.Decimal(12, 2)
  discountAmount         Decimal                 @default(0) @db.Decimal(12, 2)
  shippingFee            Decimal                 @default(0) @db.Decimal(12, 2)
  totalAmount            Decimal                 @db.Decimal(12, 2)
  paymentMethod          PaymentMethod
  paymentStatus          PaymentStatus           @default(UNPAID)
  orderStatus            OrderStatus             @default(PENDING)
  paidAt                 DateTime?
  loyaltyRewardGrantedAt DateTime?
  loyaltyRewardRevokedAt DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  affiliateProfileId     String?
  affiliateRefCode       String?
  shippingDistrictCode   String?
  shippingFullAddress    String?
  shippingProvinceCode   String?
  shippingWardCode       String?
  cancelReason           String?
  canceledAt             DateTime?
  affiliateClicks        AffiliateClick[]
  affiliateCommissions   AffiliateCommission[]
  affiliateTrafficEvents AffiliateTrafficEvent[]
  affiliateConversionMatches AffiliateConversionMatch[]
  conversionDispatchJobs     ConversionDispatchJob[]
  affiliateProfile       AffiliateProfile?       @relation(fields: [affiliateProfileId], references: [id])
  coupon                 Coupon?                 @relation(fields: [couponId], references: [id])
  customer               Customer?               @relation(fields: [customerId], references: [id])
  shippingAddress        Address?                @relation(fields: [shippingAddressId], references: [id])
  items                  OrderItem[]
  rewardPointLedgers     RewardPointLedger[]
  loyaltyTransactions    LoyaltyTransaction[]
  supportTickets         SupportTicket[]

  @@index([customerId])
  @@index([shippingAddressId])
  @@index([couponId])
  @@index([vendorId])
  @@index([affiliateProfileId])
  @@index([affiliateRefCode])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  points      Int
  type        String   @db.VarChar(64)
  description String   @db.Text
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([orderId])
  @@index([customerId, createdAt])
}

model AffiliateProfile {
  id                          String                                @id @default(cuid())
  customerId                  String?
  adminId                     String?
  refCode                     String                                @unique
  status                      AffiliateStatus                       @default(ACTIVE)
  commissionRate              Decimal?                              @db.Decimal(5, 2)
  createdAt                   DateTime                              @default(now())
  updatedAt                   DateTime                              @updatedAt
  clicks                      AffiliateClick[]
  commissions                 AffiliateCommission[]
  campaigns                   AffiliateCampaign[]
  trackingLinks               AffiliateTrackingLink[]
  realtimeSessions            AffiliateRealtimeSession[]
  trafficEvents               AffiliateTrafficEvent[]
  payoutAccount               AffiliatePayoutAccount?
  payoutAccountChangeRequests AffiliatePayoutAccountChangeRequest[]
  admin                       Admin?                                @relation(fields: [adminId], references: [id])
  customer                    Customer?                             @relation(fields: [customerId], references: [id])
  withdrawalRequests          AffiliateWithdrawalRequest[]
  orders                      Order[]
  rewardPointLogs             RewardPointLedger[]
  hourlyAggregates            AffiliateHourlyAggregate[]
  dailyAggregates             AffiliateDailyAggregate[]
  pixelIntegrations           AffiliatePixelIntegration[]
  affiliateAttributions       AffiliateAttribution[]
  conversionMatches           AffiliateConversionMatch[]
  conversionDispatchJobs      ConversionDispatchJob[]
  conversionReplayLogs        ConversionReplayLog[]
  trackingIngestLogs          AffiliateTrackingIngestLog[]
  fraudCases                  AffiliateFraudCase[]
  fraudScores                 AffiliateFraudScore[]
  fraudActions                AffiliateFraudAction[]
  fraudScoreTier              AffiliateFraudTier                   @default(LOW)
  fraudDispatchHoldUntil      DateTime?
  fraudCommissionSoftHold     Boolean                            @default(false)

  @@index([customerId])
  @@index([adminId])
  @@index([status])
}

model AffiliatePayoutAccount {
  id                      String                               @id @default(cuid())
  affiliateProfileId      String                               @unique
  bankName                String
  bankAccountNumber       String
  bankAccountHolder       String
  citizenIdFrontObjectKey String
  citizenIdBackObjectKey  String
  verificationStatus      AffiliatePayoutVerificationStatus    @default(PENDING)
  rejectionReason         String?
  verifiedAt              DateTime?
  createdAt               DateTime                             @default(now())
  updatedAt               DateTime                             @updatedAt
  verifiedByAdminId       String?
  affiliateProfile        AffiliateProfile                     @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)
  verifiedByAdmin         Admin?                               @relation(fields: [verifiedByAdminId], references: [id])
  changeRequests          AffiliatePayoutAccountChangeRequest?

  @@index([verificationStatus])
  @@index([verifiedByAdminId])
}

/// DB: partial unique index on ("payoutAccountId") WHERE status = PENDING (see migration partial_unique_pending_payout_change_request).
model AffiliatePayoutAccountChangeRequest {
  id                         String                             @id @default(cuid())
  payoutAccountId            String                             @unique(map: "AffiliatePayoutAccountChangeRequest_payout_pending_partial_uidx", where: raw("(status = 'PENDING'::\"AffiliatePayoutChangeRequestStatus\")"))
  affiliateProfileId         String
  currentBankName            String
  currentBankAccountNumber   String
  currentBankAccountHolder   String
  requestedBankName          String
  requestedBankAccountNumber String
  requestedBankAccountHolder String
  citizenIdFrontObjectKey    String
  citizenIdBackObjectKey     String
  status                     AffiliatePayoutChangeRequestStatus @default(PENDING)
  rejectionReason            String?
  requestedAt                DateTime                           @default(now())
  reviewedAt                 DateTime?
  reviewedByAdminId          String?
  createdAt                  DateTime                           @default(now())
  updatedAt                  DateTime                           @updatedAt
  affiliateProfile           AffiliateProfile                   @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)
  payoutAccount              AffiliatePayoutAccount             @relation(fields: [payoutAccountId], references: [id], onDelete: Cascade)
  reviewedByAdmin            Admin?                             @relation("PayoutChangeRequestReviewer", fields: [reviewedByAdminId], references: [id])

  @@index([affiliateProfileId])
  @@index([payoutAccountId])
  @@index([status])
  @@index([requestedAt])
}

model AffiliateClick {
  id                 String           @id @default(cuid())
  affiliateProfileId String
  refCode            String
  landingPage        String?
  referrer           String?
  utmSource          String?
  utmCampaign        String?
  device             String?
  browser            String?
  visitorKey         String?
  sessionKey         String?
  orderId            String?
  createdAt          DateTime         @default(now())
  affiliateProfile   AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)
  order              Order?           @relation(fields: [orderId], references: [id])

  @@index([affiliateProfileId])
  @@index([refCode])
  @@index([visitorKey])
  @@index([sessionKey])
  @@index([orderId])
  @@index([createdAt])
}

model AffiliateCommission {
  id                 String                    @id @default(cuid())
  affiliateProfileId String
  orderId            String
  orderRevenue       Decimal                   @db.Decimal(12, 2)
  commissionRate     Decimal                   @db.Decimal(5, 2)
  amount             Decimal                   @db.Decimal(12, 2)
  status             AffiliateCommissionStatus @default(PENDING)
  createdAt          DateTime                  @default(now())
  approvedAt         DateTime?
  unlockAt           DateTime?
  availableAt        DateTime?
  releasedAt         DateTime?
  paidAt             DateTime?
  affiliateProfile   AffiliateProfile          @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)
  order              Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([affiliateProfileId, orderId])
  @@index([affiliateProfileId])
  @@index([orderId])
  @@index([status])
  @@index([status, unlockAt])
  @@index([createdAt])
}

model RewardPointLedger {
  id                 String            @id @default(cuid())
  affiliateProfileId String
  orderId            String?
  points             Int
  type               RewardPointType
  status             RewardPointStatus @default(PENDING)
  reason             String?
  createdAt          DateTime          @default(now())
  affiliateProfile   AffiliateProfile  @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)
  order              Order?            @relation(fields: [orderId], references: [id])

  @@index([affiliateProfileId])
  @@index([orderId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model AffiliateWithdrawalRequest {
  id                 String                    @id @default(cuid())
  affiliateProfileId String
  amount             Decimal                   @db.Decimal(12, 2)
  availableAmount    Decimal?                  @db.Decimal(12, 2)
  paymentMethod      String
  paymentInfo        String
  status             AffiliateWithdrawalStatus @default(PENDING)
  adminNote          String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  approvedAt         DateTime?
  paidAt             DateTime?
  rejectedAt         DateTime?
  affiliateProfile   AffiliateProfile          @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  @@index([affiliateProfileId])
  @@index([status])
  @@index([createdAt])
}

model AffiliateApplication {
  id                 String                     @id @default(cuid())
  customerId         String
  fullName          String
  phone             String
  email             String?
  socialLink        String?
  experience        String?                    @db.Text
  note              String?
  status            AffiliateApplicationStatus @default(PENDING)
  adminNote         String?
  reviewedAt        DateTime?
  reviewedByAdminId String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  followerCount     Int?
  quickReviewNote   String?
  score             Int?
  scoreReason       String?
  sellingCategories String?
  trafficSource     String?
  customer          Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reviewedByAdmin   Admin?                     @relation("AffiliateApplicationReviewer", fields: [reviewedByAdminId], references: [id])
  supportTickets    SupportTicket[]

  @@index([customerId])
  @@index([status])
  @@index([customerId, status])
  @@index([createdAt])
  @@index([reviewedByAdminId])
}

model SupportTicket {
  id                     String                 @id @default(cuid())
  customerId             String                 @unique(map: "SupportTicket_one_active_general_per_customer", where: raw("((type = 'GENERAL'::\"SupportTicketType\") AND (\"orderId\" IS NULL) AND (\"affiliateApplicationId\" IS NULL) AND (status = ANY (ARRAY['OPEN'::\"SupportTicketStatus\", 'PENDING'::\"SupportTicketStatus\", 'WAITING_ADMIN'::\"SupportTicketStatus\", 'WAITING_USER'::\"SupportTicketStatus\"])))"))
  subject                String
  type                   SupportTicketType
  status                 SupportTicketStatus    @default(OPEN)
  orderId                String?
  affiliateApplicationId String?
  lastMessageAt          DateTime               @default(now())
  customerUnreadCount    Int                    @default(0)
  adminUnreadCount       Int                    @default(0)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  assignedAdminId        String?
  /// Thời điểm đã gửi tin auto-reply (tối đa 1 lần / ticket).
  autoReplySentAt        DateTime?
  priority               SupportTicketPriority  @default(MEDIUM)
  tags                   String[]               @default([])
  deletedAt              DateTime?
  deletedByAdminId       String?
  affiliateApplication   AffiliateApplication?  @relation(fields: [affiliateApplicationId], references: [id])
  assignedAdmin          Admin?                 @relation("SupportTicketAssignee", fields: [assignedAdminId], references: [id])
  deletedByAdmin         Admin?                 @relation("SupportTicketSoftDeletedBy", fields: [deletedByAdminId], references: [id])
  blockedAt              DateTime?
  blockedByAdminId       String?
  blockReason            String?
  blockedByAdmin         Admin?                 @relation("SupportTicketBlockedBy", fields: [blockedByAdminId], references: [id])
  customer               Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order                  Order?                 @relation(fields: [orderId], references: [id])
  messages               SupportTicketMessage[]

  @@index([customerId])
  @@index([customerId, status])
  @@index([orderId])
  @@index([affiliateApplicationId])
  @@index([assignedAdminId])
  @@index([lastMessageAt])
  @@index([deletedAt])
  @@index([blockedAt])
}

model SupportTicketMessage {
  id               String                  @id @default(cuid())
  ticketId         String
  senderCustomerId String?
  senderAdminId    String?
  senderRole       SupportTicketSenderRole
  body             String
  createdAt        DateTime                @default(now())
  /// Id người đã xem tin (customerId hoặc adminId tùy vai trò đăng nhập).
  seenBy           String[]                @default([])
  /// Tin tự động từ bot (nội bộ, không hiển thị khác biệt bắt buộc trên API).
  isAutoReply      Boolean                 @default(false)
  deletedAt        DateTime?
  deletedByAdminId String?
  senderAdmin      Admin?                  @relation("AdminSupportTicketMessage", fields: [senderAdminId], references: [id])
  deletedByAdmin   Admin?                  @relation("SupportTicketMessageSoftDeletedBy", fields: [deletedByAdminId], references: [id])
  senderCustomer   Customer?               @relation("CustomerSupportTicketMessage", fields: [senderCustomerId], references: [id])
  ticket           SupportTicket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([ticketId, createdAt])
  @@index([deletedAt])
}

/// Hội thoại hỗ trợ trực tiếp (một inbox / khách), thay thế flow ticket GENERAL trên storefront.
model SupportDmConversation {
  id                  String             @id @default(cuid())
  customerId          String             @unique
  customerUnreadCount Int                @default(0)
  adminUnreadCount    Int                @default(0)
  lastMessageAt       DateTime           @default(now())
  blockedAt           DateTime?
  blockedByAdminId    String?
  blockReason         String?            @db.VarChar(500)
  hiddenByAdminAt     DateTime?
  hiddenByAdminId     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  customer            Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)

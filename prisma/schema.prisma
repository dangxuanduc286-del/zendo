enum AffiliateConversionMatchState {
  MATCHED
  PARTIAL_MATCH
  UNATTRIBUTED
  SUSPICIOUS
  DUPLICATE
}

/// Deterministic conversion attribution (replay-safe unique per affiliate + order).
model AffiliateConversionMatch {
  id                 String                        @id @default(cuid())
  affiliateProfileId String
  orderId            String                        @db.VarChar(64)
  sessionId          String?                       @db.VarChar(80)
  visitorKey         String?                       @db.VarChar(120)
  state              AffiliateConversionMatchState
  winningModel       String                        @default("last_click") @db.VarChar(32)
  fingerprint        String                        @db.VarChar(64)
  touchCount         Int                           @default(0)
  window1hTouches    Int                           @default(0)
  window24hTouches   Int                           @default(0)
  window7dTouches    Int                           @default(0)
  window30dTouches   Int                           @default(0)
  duplicatePaidHits  Int                           @default(0)
  selfReferralRisk   Boolean                       @default(false)
  commissionMinor    Int?
  revenueMinor       Int?
  anchorAt           DateTime?
  signals            Json?
  metadata           Json?
  resolvedAt         DateTime                      @default(now())
  replayVersion      Int                           @default(1)
  affiliateProfile   AffiliateProfile              @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)
  order              Order                         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  touches            AffiliateAttributionTouch[]
  campaignChains     AffiliateCampaignChain[]
  sourceChains       AffiliateSourceChain[]
  conversionDispatchJobs ConversionDispatchJob[]

  @@unique([affiliateProfileId, orderId])
  @@index([affiliateProfileId, state, resolvedAt])
  @@index([affiliateProfileId, resolvedAt])
  @@index([state, resolvedAt])
}

/// Ordered touchpoints for funnel replay / multi-touch foundation.
model AffiliateAttributionTouch {
  id                String                   @id @default(cuid())
  conversionMatchId String
  sequence          Int
  trafficEventId    String?
  touchedAt         DateTime
  eventType         String                   @db.VarChar(40)
  pathname          String?                  @db.VarChar(512)
  referrer          String?                  @db.VarChar(1024)
  utmSource         String?                  @db.VarChar(120)
  utmMedium         String?                  @db.VarChar(120)
  utmCampaign       String?                  @db.VarChar(160)
  subid             String?                  @db.VarChar(120)
  device            String?                  @db.VarChar(60)
  browser           String?                  @db.VarChar(60)
  productId         String?
  trackingLinkId    String?
  conversionMatch   AffiliateConversionMatch @relation(fields: [conversionMatchId], references: [id], onDelete: Cascade)
  trafficEvent      AffiliateTrafficEvent?   @relation(fields: [trafficEventId], references: [id], onDelete: SetNull)

  @@unique([conversionMatchId, sequence])
  @@index([conversionMatchId])
}

model AffiliateCampaignChain {

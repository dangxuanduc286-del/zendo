  latencyMs         Int?
  responseSnippet   String?                   @db.VarChar(500)
  createdAt         DateTime                  @default(now())
  dispatchJob       ConversionDispatchJob   @relation(fields: [dispatchJobId], references: [id], onDelete: Cascade)

  @@index([dispatchJobId])
}

model ConversionReplayLog {
  id                 String                    @id @default(cuid())

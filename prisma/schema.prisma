model AffiliateFraudSignal {
  id        String             @id @default(cuid())
  caseId    String
  code      String             @db.VarChar(64)
  tier      AffiliateFraudTier @default(MEDIUM)
  evidence  Json?
  createdAt DateTime           @default(now())
  case      AffiliateFraudCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model AffiliateFraudScore {
  id                   String             @id @default(cuid())
  affiliateProfileId String
  caseId               String?
  scope                String             @db.VarChar(32)
  scopeKey             String?            @db.VarChar(180)
  numericScore         Int
  tier                 AffiliateFraudTier
  confidence           Decimal            @db.Decimal(4, 3)
  breakdown            Json?
  createdAt            DateTime           @default(now())
  affiliateProfile     AffiliateProfile   @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)
  case                 AffiliateFraudCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([affiliateProfileId, createdAt])
}

model AffiliateFraudAction {
  id                   String                 @id @default(cuid())
  affiliateProfileId   String
  caseId               String?
  actionType           AffiliateFraudActionType
  payload              Json?
  adminId              String?
  createdAt            DateTime               @default(now())
  affiliateProfile     AffiliateProfile       @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)
  case                 AffiliateFraudCase?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  admin                Admin?                 @relation(fields: [adminId], references: [id])

  @@index([affiliateProfileId, createdAt])
}

/// Log ingest API (audit, health) — không lưu full payload.
model AffiliateTrackingIngestLog {
  id                 String            @id @default(cuid())
  affiliateProfileId String?
  route              String            @db.VarChar(160)
  eventType          String?           @db.VarChar(64)
  success            Boolean
  statusCode         Int
  ipHash             String?           @db.VarChar(64)
  message            String?           @db.VarChar(500)
  latencyMs          Int?
  payloadBytes       Int?
  eventCount         Int               @default(1)
  createdAt          DateTime          @default(now())
  affiliateProfile   AffiliateProfile? @relation(fields: [affiliateProfileId], references: [id], onDelete: SetNull)

  @@index([affiliateProfileId, createdAt])
  @@index([createdAt])
  @@index([success, createdAt])
}

